# Vente d'abonnements : copier en .env.local (ignoré par Git) pour le développement.
# En production, ces valeurs viennent des variables du dépôt GitHub
# (voir README.md, « Déploiement », et .github/workflows/deploy-production.yml).

# Interrupteur de la vente. true : pages Tarifs, Inscription et Retour de paiement, lien « Tarifs » au menu,
# liens vers les tarifs dans les pages et vers les CGV, les CGU et l'accord de sous-traitance dans le pied de page.
# false ou absent : ces pages ne sont pas enregistrées et ces liens n'apparaissent pas.
# Le reste du site n'en dépend pas : les pages des documents légaux et le choix des cookies restent en place.
# Build de production avec true, hors maquette : il échoue si cgv, accord-sous-traitance ou cgu-app ont le statut
# « projet », ou si VITE_API_URL ou VITE_APP_WEB_URL sont vides. Ne jamais l'activer sur main avant la fusion (README.md).
VITE_BILLING_ACTIF=true

# Mode maquette : toutes les réponses de l'API sont simulées, aucun backend nécessaire.
# Développement seulement : le workflow de production ne transmet jamais cette variable.
VITE_BILLING_MOCK=true
# Maquette seulement : simule PMS_DISPONIBLE (versions « engagées » et lignes PMS).
VITE_BILLING_MOCK_PMS=false

# API publique d'Apirest (sans / final ; les routes sont ajoutées derrière : /api/billing/…).
# Valeur de production. Ignorée tant que VITE_BILLING_MOCK=true.
VITE_API_URL=https://api.restoclair.fr/v1
# Version web de l'application (l'espace client est {VITE_APP_WEB_URL}/mon-compte). Valeur de production.
VITE_APP_WEB_URL=https://app.restoclair.fr

# Fiches de l'application dans les magasins (boutons de la page de retour).
# Vides tant que les applications ne sont pas publiées : les boutons restent masqués.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
