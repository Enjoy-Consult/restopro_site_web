# Vente d'abonnements : copier en .env.local (ignoré par Git) pour le développement.
# En production, ces valeurs viennent des variables du dépôt GitHub (voir .github/workflows/deploy.yml).

# Interrupteur général : false ou absent = le site reste comme avant (pages non enregistrées, pas de lien « Tarifs »).
VITE_BILLING_ACTIF=true

# Mode maquette : toutes les réponses de l'API sont simulées, aucun backend nécessaire.
VITE_BILLING_MOCK=true
# Maquette seulement : simule PMS_DISPONIBLE (versions « engagées » et lignes PMS).
VITE_BILLING_MOCK_PMS=false

# API publique d'Apirest (sans / final) et version web de l'application.
VITE_API_URL=
VITE_APP_WEB_URL=

# Fiches de l'application dans les magasins (boutons de la page de retour ; masqués si vides).
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
